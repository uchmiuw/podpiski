<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.project.controller.MainController"
      stylesheets="@styles.css">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Управление подписками"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Label text="Подписки пользователей" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <TableView fx:id="table" VBox.vgrow="ALWAYS" prefHeight="300">
        <columns>
            <TableColumn fx:id="colId"           text="ID"           prefWidth="50"/>
            <TableColumn fx:id="colUser"         text="Пользователь" prefWidth="180"/>
            <TableColumn fx:id="colSubscription" text="Тариф"        prefWidth="120"/>
            <TableColumn fx:id="colPrice"        text="Цена"         prefWidth="100"/>
            <TableColumn fx:id="colDuration"     text="Длительность" prefWidth="120"/>
            <TableColumn fx:id="colDescription"  text="Описание"     prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Separator/>

    <Label text="Назначить подписку" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Пользователь:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
            <ComboBox fx:id="userCombo" prefWidth="300" promptText="Выберите пользователя"/>
            <Button text="+ Новый пользователь" onAction="#onCreateUserButtonClick"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-padding: 5 10 5 10;"/>
        </HBox>

        <Label text="Тариф:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="subscriptionCombo" prefWidth="300" promptText="Выберите тариф"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Добавить подписку" onAction="#onAddButtonClick"
                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Обновить тариф" onAction="#onUpdateButtonClick"
                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Удалить" onAction="#onDeleteButtonClick"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Очистить" onAction="#onClearButtonClick"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
    </HBox>

</VBox>